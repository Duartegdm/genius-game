    {
        "id": "fn_atualiza_ranking",
        "type": "function",
        "z": "tab_genius",
        "name": "Atualiza Ranking Top 10",
        "func": "// ============================================================\n// FUNÇÃO PRINCIPAL: Gerencia o ranking persistente dos jogadores\n// Recebe: msg.payload = { tag: \"ABC\", score: 15 }\n// ============================================================\n\n// 1. Valida os dados recebidos do ESP32\nvar tag   = msg.payload.tag;\nvar score = parseInt(msg.payload.score);\n\nif (!tag || isNaN(score)) {\n    node.warn(\"Payload inválido recebido: \" + JSON.stringify(msg.payload));\n    return null;\n}\n\n// 2. Recupera o ranking atual do flow context\nvar ranking = flow.get('ranking') || [];\n\n// 3. Verifica se o jogador já está no ranking pela TAG\nvar indice = ranking.findIndex(function(j) { return j.tag === tag; });\n\nif (indice !== -1) {\n    // Jogador já existe: atualiza só se o novo score for MAIOR\n    if (score > ranking[indice].score) {\n        ranking[indice].score = score;\n        ranking[indice].timestamp = new Date().toLocaleString('pt-BR');\n    }\n} else {\n    // Novo jogador: adiciona ao ranking\n    ranking.push({\n        tag: tag,\n        score: score,\n        timestamp: new Date().toLocaleString('pt-BR')\n    });\n}\n\n// 4. Ordena do maior para o menor score\nranking.sort(function(a, b) { return b.score - a.score; });\n\n// 5. Mantém apenas o Top 10\nvar top10 = ranking.slice(0, 10);\n\n// 6. Salva o ranking atualizado no flow context (persistência)\nflow.set('ranking', top10);\n\n// 7. Monta o texto do ranking para exibição\nvar texto = \"\";\ntop10.forEach(function(j, i) {\n    var medalha = i===0?'🥇':i===1?'🥈':i===2?'🥉':'  ';\n    texto += medalha + ' #'+(i+1)+' | '+j.tag.toUpperCase()+' | '+j.score+' pts | '+j.timestamp+'\\n';\n});\n\n// 8. Envia para as 3 saídas\nreturn [\n    { payload: texto },\n    { payload: \"🎮 \" + tag.toUpperCase() + \" → \" + score + \" pontos\" },\n    { payload: \"Jogadores únicos no ranking: \" + top10.length }\n];\n",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 140,
        "wires": [
            [
                "ui_text_ranking",
                "debug_ranking"
            ],
            [
                "ui_text_ultimo"
            ],
            [
                "ui_text_contador"
            ]
        ]
    },
